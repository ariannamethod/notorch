      "name": "retained_finite_check",
      "source_sha256": "92e0f89639b4b8083d60fab31ab5d8580b7935534468c01a4e3852b0628fdcd3",
      "source": "#define _GNU_SOURCE\n#include <immintrin.h>\n#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <time.h>\n#include <sys/resource.h>\nstatic inline float nt_f16_to_f32(uint16_t h) { return _cvtsh_ss(h); }\nstatic inline float nt_hsum256_ps(__m256 v) {\n    __m128 lo = _mm256_castps256_ps128(v), hi = _mm256_extractf128_ps(v, 1);\n    lo = _mm_add_ps(lo, hi);\n    __m128 sh = _mm_movehl_ps(lo, lo); lo = _mm_add_ps(lo, sh);\n    sh = _mm_shuffle_ps(lo, lo, 0x1);  lo = _mm_add_ss(lo, sh);\n    return _mm_cvtss_f32(lo);\n}\nstatic void baseline(float *out, const uint8_t *W, const float *x,\n                         int r0, int r1, int k) {\n    int nb = k / 32;\n    for (int row = r0; row < r1; row++) {\n        const uint8_t *rb = W + (long)row * nb * 34;\n#if defined(__AVX2__) && defined(__FMA__)\n        __m256 a0 = _mm256_setzero_ps(), a1 = _mm256_setzero_ps(),\n               a2 = _mm256_setzero_ps(), a3 = _mm256_setzero_ps();\n        for (int blk = 0; blk < nb; blk++) {\n            const uint8_t *b = rb + (long)blk * 34;\n            __m256 d = _mm256_set1_ps(nt_f16_to_f32((uint16_t)(b[0] | (b[1] << 8))));\n            const float *xb = x + (long)blk * 32;\n            __m128i q0 = _mm_loadu_si128((const __m128i *)(b + 2));\n            __m128i q1 = _mm_loadu_si128((const __m128i *)(b + 18));\n            __m256 w0 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(q0));\n            __m256 w1 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_srli_si128(q0, 8)));\n            __m256 w2 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(q1));\n            __m256 w3 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_srli_si128(q1, 8)));\n            a0 = _mm256_fmadd_ps(_mm256_mul_ps(d, w0), _mm256_loadu_ps(xb),      a0);\n            a1 = _mm256_fmadd_ps(_mm256_mul_ps(d, w1), _mm256_loadu_ps(xb + 8),  a1);\n            a2 = _mm256_fmadd_ps(_mm256_mul_ps(d, w2), _mm256_loadu_ps(xb + 16), a2);\n            a3 = _mm256_fmadd_ps(_mm256_mul_ps(d, w3), _mm256_loadu_ps(xb + 24), a3);\n        }\n        out[row] = nt_hsum256_ps(_mm256_add_ps(_mm256_add_ps(a0, a1), _mm256_add_ps(a2, a3)));\n#else\n        float acc = 0.0f;\n        for (int blk = 0; blk < nb; blk++) {\n            const uint8_t *b = rb + (long)blk * 34;\n            float d = nt_f16_to_f32((uint16_t)(b[0] | (b[1] << 8)));\n            const float *xb = x + (long)blk * 32;\n            for (int i = 0; i < 32; i++)\n                acc += d * (float)(int8_t)b[2 + i] * xb[i];\n        }\n        out[row] = acc;\n#endif\n    }\n}\n\nstatic void paired(float *out, const uint8_t *W, const float *x,\n                         int r0, int r1, int k) {\n    int nb = k / 32;\n    for (int row = r0; row < r1; row++) {\n        const uint8_t *rb = W + (long)row * nb * 34;\n#if defined(__AVX2__) && defined(__FMA__)\n        __m256 a0 = _mm256_setzero_ps(), a1 = _mm256_setzero_ps(),\n               a2 = _mm256_setzero_ps(), a3 = _mm256_setzero_ps();\n        for (int blk = 0; blk < nb; blk++) {\n            const uint8_t *b = rb + (long)blk * 34;\n            __m256 d = _mm256_set1_ps(nt_f16_to_f32((uint16_t)(b[0] | (b[1] << 8))));\n            const float *xb = x + (long)blk * 32;\n            __m128i q0 = _mm_loadu_si128((const __m128i *)(b + 2));\n            __m128i q1 = _mm_loadu_si128((const __m128i *)(b + 18));\n            __m256 w0 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(q0));\n            __m256 w1 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_srli_si128(q0, 8)));\n            __m256 w2 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(q1));\n            __m256 w3 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_srli_si128(q1, 8)));\n            a0 = _mm256_fmadd_ps(_mm256_mul_ps(d, w0), _mm256_loadu_ps(xb),      a0);\n            a1 = _mm256_fmadd_ps(_mm256_mul_ps(d, w1), _mm256_loadu_ps(xb + 8),  a1);\n            a2 = _mm256_fmadd_ps(_mm256_mul_ps(d, w2), _mm256_loadu_ps(xb + 16), a2);\n            a3 = _mm256_fmadd_ps(_mm256_mul_ps(d, w3), _mm256_loadu_ps(xb + 24), a3);\n        }\n        out[row] = nt_hsum256_ps(_mm256_add_ps(_mm256_add_ps(a0, a1), _mm256_add_ps(a2, a3)));\n        if (isfinite(out[row])) continue;\n        /* Partial sums or their fold can overflow even when the sequential dot\n         * stays finite through cancellation. Retry only that row in the scalar\n         * order; ordinary rows retain the SIMD result bit for bit. */\n#endif\n        float acc = 0.0f;\n        for (int blk = 0; blk < nb; blk++) {\n            const uint8_t *b = rb + (long)blk * 34;\n            float d = nt_f16_to_f32((uint16_t)(b[0] | (b[1] << 8)));\n            const float *xb = x + (long)blk * 32;\n            for (int i = 0; i < 32; i++)\n                acc += d * (float)(int8_t)b[2 + i] * xb[i];\n        }\n        out[row] = acc;\n    }\n}\n\nstatic uint32_t rng=1;\nstatic uint32_t next(void) {rng^=rng<<13;rng^=rng>>17;rng^=rng<<5;return rng;}\nstatic double now(void) {struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);return t.tv_sec+t.tv_nsec*1e-9;}\ntypedef void (*kernel)(float *,const uint8_t *,const float *,int,int,int);\nstatic double time_kernel(kernel f,float *out,const uint8_t *W,const float*x,int rows,int k,int reps) {\n    double start=now();for(int r=0;r<reps;r++) f(out,W,x,0,rows,k); return (now()-start)*1000/reps;\n}\nint main(void) {\n    int shapes[][2]={{64,32},{1152,1152},{6912,1152},{1152,6912},{4096,4096},{32768,2048}};\n    for(int s=0;s<6;s++) {\n      int rows=shapes[s][0],k=shapes[s][1],nb=k/32;\n      size_t bytes=(size_t)rows*nb*34;\n      uint8_t *W=malloc(bytes);float*x=malloc(k*4),*a=malloc(rows*4),*b=malloc(rows*4);\n      for(size_t j=0;j<bytes;j+=34) {uint16_t h=0x2000+(next()%0x2000); W[j]=h;W[j+1]=h>>8;\n        for(int t=2;t<34;t++) W[j+t]=next();}\n      for(int j=0;j<k;j++) x[j]=((int)(next()%10000)-5000)/717.0f;\n      baseline(a,W,x,0,rows,k);paired(b,W,x,0,rows,k);\n      if(memcmp(a,b,rows*4)) {puts(\"DIFFERENT\");return 1;}\n      int reps=(int)(200000000/bytes);if(reps<3)reps=3;if(reps>20000)reps=20000;\n      for(int t=0;t<3;t++) {baseline(a,W,x,0,rows,k);paired(b,W,x,0,rows,k);}\n      struct rusage ru;getrusage(RUSAGE_SELF,&ru);\n      for(int t=0;t<9;t++) {\n        double ta,tb;if(t%2) {tb=time_kernel(paired,b,W,x,rows,k,reps);ta=time_kernel(baseline,a,W,x,rows,k,reps);}\n        else {ta=time_kernel(baseline,a,W,x,rows,k,reps);tb=time_kernel(paired,b,W,x,rows,k,reps);}\n        printf(\"%d %d %d %zu %ld %.8f %.8f %.6f\\n\",rows,k,reps,bytes,ru.ru_maxrss,ta,tb,ta/tb);fflush(stdout);\n      }\n      free(W);free(x);free(a);free(b);\n    } return 0;\n}\n",
