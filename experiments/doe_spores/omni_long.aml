# 24 visual waking turns, six dreams, Q8 -> F16 -> Q8. All inference is native C.
# stdin: notorch_omni, notorch, doe_probe, Q8 full Omni, F16 full Omni, fixtures, new output dir.
# fixtures: left-red.ppm and left-blue.ppm; generated by omni_fixtures.c.
def cat(a, b):
    return text_concat(a, b)

def col(a, b):
    return cat(cat(a, '\t'), b)

def path(name):
    return cat(cat(outdir, '/'), name)

def spore(name):
    return path(cat(name, '.gguf'))

def lines(name, text):
    rest = text
    end = text_find(rest, '\n')
    while end >= 0:
        assert(file_append_line(path(name), text_slice(rest, 0, end)) == 1, name)
        rest = text_slice(rest, end+1, text_len(rest))
        end = text_find(rest, '\n')
    if text_len(rest) > 0:
        assert(file_append_line(path(name), rest) == 1, name)

def cmd(binary):
    a = list_new()
    list_push(a, binary)
    return a

def run(a, name):
    result = process_run(a, env, 600)
    err = record_get(result, 'stderr')
    lines(cat(name, '.trace'), err)
    lines(cat(name, '.txt'), record_get(result, 'stdout'))
    if record_get(result, 'status') != 0:
        PRINT err
    assert(record_get(result, 'status') == 0, name)
    return result

def wake(host, image, parent, name, worker, sleep):
    a = cmd(omni)
    list_push(a, '--mode')
    list_push(a, 'text')
    list_push(a, '--experts')
    list_push(a, '--learn-experts')
    list_push(a, '--expert-trace')
    if worker:
        list_push(a, '--async-consolidation')
    if sleep:
        list_push(a, '--dream-tokens')
        list_push(a, '6')
    if text_len(parent) > 0:
        list_push(a, '--spore-in')
        list_push(a, spore(parent))
    list_push(a, '--portable-spore')
    list_push(a, '--spore-out')
    list_push(a, spore(name))
    list_push(a, '--image')
    list_push(a, cat(cat(fixtures, '/left-'), cat(image, '.ppm')))
    list_push(a, '-n')
    list_push(a, '3')
    list_push(a, host)
    list_push(a, question)
    result = run(a, name)
    trace = record_get(result, 'stderr')
    assert(text_find(trace, cat(cat('doe turn=', text_fixed(episode, 0)), ' elections=')) >= 0, 'waking clock')
    assert(text_find(trace, ' media=72 ') >= 0, '72 visual elections')
    return record_get(result, 'stdout')

def dream(host, parent, name):
    a = cmd(cli)
    list_push(a, '--experts')
    list_push(a, '--learn-experts')
    list_push(a, '--expert-trace')
    list_push(a, '--dream-only')
    list_push(a, '6')
    list_push(a, '--spore-in')
    list_push(a, spore(parent))
    list_push(a, '--portable-spore')
    list_push(a, '--spore-out')
    list_push(a, spore(name))
    list_push(a, host)
    result = run(a, name)
    assert(text_len(record_get(result, 'stdout')) == 0, 'private dream stdout')
    assert(text_find(record_get(result, 'stderr'), 'doe dream-end ') >= 0, 'complete private dream')

def score(host, parent, name, image):
    a = cmd(omni)
    list_push(a, '--mode')
    list_push(a, 'text')
    list_push(a, '--expert-trace')
    if text_len(parent) > 0:
        list_push(a, '--experts')
        list_push(a, '--spore-in')
        list_push(a, spore(parent))
    if text_equal(image, 'text') == 0:
        list_push(a, '--image')
        list_push(a, cat(cat(fixtures, '/left-'), cat(image, '.ppm')))
    list_push(a, '--logits-out')
    list_push(a, path(cat(name, '.f32')))
    list_push(a, '-n')
    list_push(a, '3')
    list_push(a, host)
    if text_equal(image, 'text'):
        list_push(a, 'Earlier you saw a picture. Which color was on the left? Reply with one color.')
    else:
        list_push(a, question)
    run(a, name)
    a = cmd(helper)
    list_push(a, 'pack-logits')
    list_push(a, host)
    list_push(a, path(cat(name, '.f32')))
    list_push(a, path(cat(name, '.amlck')))
    list_push(a, 'Red')
    list_push(a, 'Blue')
    run(a, cat(name, '-pack'))
    data = checkpoint_load(path(cat(name, '.amlck')))
    lg = record_get(data, 'probe0')
    left = record_get(data, 'left_id')
    right = record_get(data, 'right_id')
    probs = softmax(lg)
    row = col(col(col(name, text_fixed(left, 0)), text_fixed(right, 0)), text_fixed(lg[left]-lg[right], 9))
    lines('scores.tsv', col(col(row, text_fixed(probs[left], 9)), text_fixed(probs[right], 9)))

def measure(host, parent, name):
    score(host, parent, cat(name, '-red'), 'red')
    score(host, parent, cat(name, '-blue'), 'blue')
    score(host, parent, cat(name, '-text'), 'text')

omni = list_get(read_line(), 0)
cli = list_get(read_line(), 0)
helper = list_get(read_line(), 0)
q8 = list_get(read_line(), 0)
f16 = list_get(read_line(), 0)
fixtures = list_get(read_line(), 0)
outdir = list_get(read_line(), 0)
assert(dir_claim(outdir) == 1, 'choose a fresh output directory')
env = record_new()
record_set(env, 'LC_ALL', 'C')
record_set(env, 'NT_ATTN_THREADS', '1')
record_set(env, 'NT_CHAT', '||')
record_set(env, 'NT_TOKENS', '')
record_set(env, 'NT_CTX', '64')
question = 'Which color is on the left? Reply with one color.'
lines('weights.tsv', col('q8', file_hash_sha256(q8)))
lines('weights.tsv', col('f16', file_hash_sha256(f16)))
lines('scores.tsv', 'state\tred_id\tblue_id\tlog_odds_red_over_blue\tp_red\tp_blue')
lines('generations.tsv', 'episode\tbody\timage\tdream\tsync\tworker\tsha256')
measure(q8, '', 'q8-plain')
measure(f16, '', 'f16-plain')
sync_parent = ''
worker_parent = ''
awake_parent = ''
episode = 1
cycle = 0
even = 0
while episode <= 24:
    host = q8
    body = 'q8'
    image = 'red'
    if episode > 8 and episode <= 16:
        host = f16
        body = 'f16'
        image = 'blue'
    if episode > 16 and even:
        image = 'blue'
    cycle = cycle + 1
    sleep = cycle == 4
    if sleep:
        cycle = 0
    label = text_fixed(episode, 0)
    sync_awake = cat('sync-', cat(label, '-awake'))
    worker = cat('worker-', label)
    awake = cat('awake-', label)
    a = wake(host, image, sync_parent, sync_awake, 0, 0)
    b = wake(host, image, worker_parent, worker, 1, sleep)
    assert(text_equal(a, b), 'sync and worker waking answer')
    wake(host, image, awake_parent, awake, 0, 0)
    sync_parent = sync_awake
    if sleep:
        sync_parent = cat('sync-', cat(label, '-night'))
        dream(host, sync_awake, sync_parent)
    digest = file_hash_sha256(spore(sync_parent))
    assert(text_equal(digest, file_hash_sha256(spore(worker))), 'sync worker exact generation')
    lines('generations.tsv', col(col(col(col(col(col(label, body), image), text_fixed(sleep, 0)), sync_parent), worker), digest))
    if sleep:
        measure(host, sync_awake, cat('before-', label))
        measure(host, sync_parent, cat('after-', label))
        measure(host, awake, cat('awake-', label))
    worker_parent = worker
    awake_parent = awake
    PRINT cat('OMNI_GENERATION_OK ', label)
    even = 1 - even
    episode = episode + 1
PRINT 'OMNI_LONG_EXPERIENCE_OK'
